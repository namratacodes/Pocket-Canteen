# Read-only role (ml_reader) used by the service at runtime
ML_DATABASE_URL=postgresql://ml_reader:change-me@localhost:5432/pocketcanteen
# Owner role, ONLY for synthetic seeding on dev/demo databases (same user as the backend DATABASE_URL)
SEED_DATABASE_URL=postgresql://pc:pc@localhost:5432/pocketcanteen
JWT_ACCESS_SECRET=change-me-access-secret-32chars   # must equal the backend value
CORS_ORIGINS=http://localhost:5173
CAMPUS_TZ=Asia/Kolkata
DATA_SOURCE=postgres            # postgres | parquet
PARQUET_DIR=data/synthetic
ARTIFACT_DIR=artifacts
VELOCITY_REFRESH_SECONDS=30
NIGHTLY_HOUR=2
NIGHTLY_MINUTE=30
RETRAIN_WINDOW_DAYS=28
RETRAIN_MAE_THRESHOLD_SECONDS=150
